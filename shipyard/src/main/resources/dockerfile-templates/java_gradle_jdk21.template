# syntax=docker/dockerfile:1
# Generated by shipyard — Java/Gradle (JDK 21) template
# 适用: Spring Boot 3.x / 普通 Java 21 Gradle 项目

# ===== Build stage =====
FROM eclipse-temurin:21-jdk AS build
WORKDIR /build

# 先 COPY gradle 配置 + wrapper, 利用 Docker 缓存
COPY build.gradle settings.gradle gradlew ./
COPY gradle ./gradle
RUN chmod +x gradlew && ./gradlew --version

# 再 COPY 源码
COPY src ./src
RUN ./gradlew clean bootJar -x test

# ===== Runtime stage =====
FROM eclipse-temurin:21-jre
WORKDIR /app

RUN groupadd -r app && useradd -r -g app app
USER app

COPY --from=build /build/build/libs/${jarName} /app/app.jar

ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"

EXPOSE ${port}

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar ${mainClassArgs}"]
