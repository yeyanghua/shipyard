# syntax=docker/dockerfile:1
# Generated by shipyard — Java/Maven (JDK 21) template
# 适用: Spring Boot 3.x / 普通 Java 21 Maven 项目

# ===== Build stage =====
FROM eclipse-temurin:21-jdk AS build
WORKDIR /build

# 先 COPY pom.xml 单独一层, 利用 Docker 缓存: pom.xml 没变就不重跑 mvn dependency
COPY pom.xml .
RUN ./mvnw -B -q dependency:go-offline || mvn -B -q dependency:go-offline

# 再 COPY 源码
COPY src ./src
RUN ./mvnw -B -q clean package -DskipTests || mvn -B -q clean package -DskipTests

# ===== Runtime stage =====
FROM eclipse-temurin:21-jre
WORKDIR /app

# 非 root 运行
RUN groupadd -r app && useradd -r -g app app
USER app

# 从 build 阶段拷 jar
COPY --from=build /build/target/${jarName} /app/app.jar

# 默认 JVM 参数 (可被 -e JAVA_OPTS="..." 覆盖)
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"

EXPOSE ${port}

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar ${mainClassArgs}"]
