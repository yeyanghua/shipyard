# syntax=docker/dockerfile:1
# Generated by shipyard — Python 3.12 / Poetry template
# 适用: FastAPI / Django / Flask 等 Python 3.12 项目

# ===== Build stage =====
FROM python:3.12-slim AS build
WORKDIR /build

# Poetry 装在 build 阶段, runtime 不需要
RUN pip install --no-cache-dir poetry==1.8.*

# 配 poetry: 虚拟环境建在项目里, 生产用
ENV POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1

COPY pyproject.toml poetry.lock* ./
RUN poetry install --only=main --no-root

# 再 COPY 源码
COPY . .
RUN poetry install --only=main

# ===== Runtime stage =====
FROM python:3.12-slim
WORKDIR /app

RUN groupadd -r app && useradd -r -g app app
USER app

# 拷 .venv + 源码
COPY --from=build /build/.venv ./.venv
COPY --from=build /build/src ./src
COPY --from=build /build/pyproject.toml ./

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PORT=${port}

EXPOSE ${port}

# 默认启动 uvicorn; 框架不同可改 CMD
CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port ${port}"]
