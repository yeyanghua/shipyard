FROM alpine:3.19
WORKDIR /app

# 装基础依赖 (bash + curl 用于 healthcheck)
RUN apk add --no-cache bash curl

# 拷产物 (V1 假设构建产物在 build/ 目录)
COPY build/ /app/

RUN addgroup -S app && adduser -S app -G app
USER app

ENV PORT=${port}

EXPOSE ${port}

# 默认命令 — 用户在 Project 详情页改
CMD ["sh", "-c", "echo 'edit CMD in Dockerfile to run your app' && sleep infinity"]
