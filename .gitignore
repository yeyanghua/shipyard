# ============================================================
# 平台项目 .gitignore
# ============================================================
# 这个文件同时是 git + Docker + IDE 的 ignore 入口
# 添加规则时分类清楚,不要全部堆在一起
# ============================================================

# ============================================================
# 0. 历史残留(不属于本项目)
# ============================================================
# 之前 Godot 项目(frozen-world)的产物,跟本平台无关
frozen-world/
frozen-world-audio/
frozen-world-sprites/
localai-deploy/
analyze_sprite.py
fix_jpeg_to_png.py
split_player_sprite.py

# 早期用过 master/ 目录,已合并到 shipyard/. 留本地作历史参考,不跟踪.
master/

# ============================================================
# 1. Java / Maven (shipyard 后端)
# ============================================================
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Spring Boot
*.original

# ============================================================
# 2. Vue / Node / Vite (shipyard Web)
# ============================================================
node_modules/
dist/
dist-ssr/
*.local

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite
.vite/
coverage/

# 前端测试
web/coverage/
web/.nyc_output/

# ============================================================
# 3. Go (worker)
# ============================================================
worker/bin/
worker/dist/
worker/vendor/
worker/coverage/
*.exe
*.dll
*.so
*.dylib

# Go test
*.test
*.out

# ============================================================
# 4. 环境变量 + 凭证(绝对不能进 git)
# ============================================================
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
*.crt
*.p12
secrets/
credentials/

# 加密 shipyard key(用 KMS/Vault 之前临时放本地)
shipyard.key

# ============================================================
# 5. IDE + 编辑器
# ============================================================
.idea/
*.iml
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# 6. OS 临时文件
# ============================================================
*.tmp
*.bak
*.swp
*~
.cache/
.tmp/
.temp/

# Windows
$RECYCLE.BIN/
*.lnk
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.Trash-*
.trash/

# ============================================================
# 7. 构建产物
# ============================================================
build/
out/
bin/
*.o
*.a
*.lib
*.so
*.dll

# Docker
**/*.pid

# ============================================================
# 8. 日志
# ============================================================
logs/
*.log
logs-*/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# 9. 覆盖率报告
# ============================================================
coverage/
*.lcov
.nyc_output/

# ============================================================
# 10. 临时数据(数据库 dump 等)
# ============================================================
*.sql
!shipyard/src/main/resources/db/migration/*.sql
!scripts/init-data/*.sql

# ============================================================
# 11. 文档生成(允许 doc/ 不允许 doc/_site 等)
# ============================================================
docs/_site/
docs/_build/
docs/.doctrees/

# ============================================================
# 12. K8s / K3s
# ============================================================
*.kubeconfig
kubeconfig
.kube/

# ============================================================
# 13. Drone
# ============================================================
.drone.yml.local
.drone.yml.bak

# ============================================================
# 14. Java spotless / License header
# ============================================================
**/spotless-*.txt
**/license-header.txt.bak

# ============================================================
# 15. 其他
# ============================================================
.history/
.qoder/
.cursor/
.aider*
.idea/

# 不忽略的例外(用 ! 排除)
# 比如 demo 视频虽然是 mp4 但要进 git
!docs/demo/*.mp4
!docs/demo/*.png
!docs/demo/*.jpg
!docs/demo/*.gif
